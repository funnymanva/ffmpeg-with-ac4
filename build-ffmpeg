##
## text / subtitle / font libraries
##

if build "freetype"; then
  download "https://download.savannah.gnu.org/releases/freetype/freetype-${FREETYPE_VERSION}.tar.xz"
  autotools_build --enable-freetype-config --without-harfbuzz --without-brotli --with-bzip2=yes --with-png=yes --with-zlib=yes
  build_done "freetype"
fi
CONFIGURE_OPTIONS+=("--enable-libfreetype")

if build "fontconfig"; then
  download "https://gitlab.freedesktop.org/api/v4/projects/890/packages/generic/fontconfig/${FONTCONFIG_VERSION}/fontconfig-${FONTCONFIG_VERSION}.tar.xz"
  # Runtime config stays at the standard /etc/fonts. Install into a staging dir
  # because 'meson install' would otherwise need root to write /etc and /var.
  execute meson setup build "${MESON_COMMON[@]}" --sysconfdir=/etc --localstatedir=/var -Ddoc=disabled \
    -Dtests=disabled -Dtools=disabled -Dcache-build=disabled -Dnls=disabled -Dxml-backend=expat
  execute meson compile -C build -j "$MJOBS"
  make_dir "${PACKAGES}/fontconfig-stage"
  execute meson install -C build --destdir "${PACKAGES}/fontconfig-stage"
  execute cp -R "${PACKAGES}/fontconfig-stage${WORKSPACE}/." "${WORKSPACE}/"
  build_done "fontconfig"
fi
CONFIGURE_OPTIONS+=("--enable-libfontconfig")

if build "libxml2"; then
  download "https://download.gnome.org/sources/libxml2/${LIBXML2_VERSION%.*}/libxml2-${LIBXML2_VERSION}.tar.xz"
  # Only used to decorate the version string, but fails the build when git is missing
  sed_i "s/run_command('git', 'describe', check: false)/run_command('sh', '-c', 'exit 1', check: false)/" meson.build
  meson_build -Dpython=disabled -Dicu=disabled -Dzlib=disabled -Diconv=enabled -Dhistory=disabled -Dreadline=disabled
  build_done "libxml2"
fi
CONFIGURE_OPTIONS+=("--enable-libxml2")

if build "libudfread"; then
