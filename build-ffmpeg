    export OPENSSL_ROOT_DIR="${WORKSPACE}"
    cmake_build . -DENABLE_SHARED=OFF -DENABLE_STATIC=ON -DENABLE_APPS=OFF -DUSE_STATIC_LIBSTDCXX=ON
    unset OPENSSL_ROOT_DIR
    if [ -n "$LDEXEFLAGS" ]; then
      sed_i 's/-lgcc_s/-lgcc_eh/g' "${WORKSPACE}/lib/pkgconfig/srt.pc"
    fi
    build_done "srt"
