#!/usr/bin/env bash

# Builds a static FFmpeg (with the Dolby AC-4 decoder patch) on macOS and Linux.
#
# Based on https://github.com/markus-perl/ffmpeg-build-script
# LICENSE: https://github.com/markus-perl/ffmpeg-build-script/blob/master/LICENSE

PROGNAME=$(basename "$0")
VERSION=2.0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CWD=$(pwd)
PACKAGES="$CWD/packages"
WORKSPACE="$CWD/workspace"

##
## Package versions - bump these to update dependencies
##
FFMPEG_VERSION=9.1
PKGCONF_VERSION=3.0.10
NASM_VERSION=3.02
ZLIB_VERSION=1.3.2
BZIP2_VERSION=1.0.8
LIBPNG_VERSION=1.6.59
EXPAT_VERSION=2.10.0
OPENSSL_VERSION=3.5.9 # LTS
SVTAV1_VERSION=4.3.0
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55 # tip of the 'stable' branch
X265_VERSION=4.1
LIBVPX_VERSION=1.17.0
XVIDCORE_VERSION=1.3.7
VIDSTAB_VERSION=1.1.2
LIBAOM_VERSION=3.15.3
OPENCORE_AMR_VERSION=0.1.6
LAME_VERSION=3.101
OPUS_VERSION=1.5.2
LIBOGG_VERSION=1.3.6
LIBVORBIS_VERSION=1.3.7
LIBTHEORA_VERSION=1.2.0
LIBGSM_VERSION=1.0.24
FREETYPE_VERSION=2.15.0
FONTCONFIG_VERSION=2.18.4
LIBXML2_VERSION=2.15.4
LIBBLURAY_VERSION=1.5.0
LIBUDFREAD_VERSION=1.2.0
FRIBIDI_VERSION=1.0.18
HARFBUZZ_VERSION=15.1.0
LIBASS_VERSION=0.17.5
LIBDRM_VERSION=2.4.134
SPEEX_VERSION=1.2.1
GMP_VERSION=6.3.0
DAV1D_VERSION=1.5.5
FDK_AAC_VERSION=2.0.3
LIBWEBP_VERSION=1.6.0
SDL2_VERSION=2.32.10
SRT_VERSION=1.5.7
NV_CODEC_VERSION=13.1.15.0

# Build tools, only downloaded if the installed ones are missing or too old
CMAKE_VERSION=4.4.5
CMAKE_MIN_VERSION=3.24
MESON_VERSION=1.12.1
MESON_MIN_VERSION=1.11.0 # fontconfig needs >= 1.11

CFLAGS="-I$WORKSPACE/include"
LDFLAGS="-L$WORKSPACE/lib"
LDEXEFLAGS=""
CONFIGURE_OPTIONS=()
NONFREE_AND_GPL=false

IS_MACOS=false
IS_LINUX=false
case "$OSTYPE" in
darwin*) IS_MACOS=true ;;
linux*) IS_LINUX=true ;;
*)
  echo "Unsupported OS: $OSTYPE"
  exit 1
  ;;
esac

ARCH="$(uname -m)"

if $IS_MACOS; then
  # Minimum macOS version the binaries will run on
  export MACOSX_DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET:-11.0}"
  CXXLIB="-lc++"
  CONFIGURE_OPTIONS+=("--enable-videotoolbox" "--enable-audiotoolbox")
else
  CXXLIB="-lstdc++"
fi
EXTRALIBS="-ldl -lpthread -lm -lz $CXXLIB"

# Speed up the process
# Env Var NUMJOBS overrides automatic detection
if [[ -n "$NUMJOBS" ]]; then
  MJOBS="$NUMJOBS"
elif $IS_MACOS; then
  MJOBS=$(sysctl -n hw.ncpu)
elif command -v nproc >/dev/null; then
  MJOBS=$(nproc)
else
  MJOBS=4
fi
# Some C++ sources (harfbuzz, x265, aom) need ~1 GB per compiler process, so
# limit jobs to about one per GB of RAM to avoid the OOM killer on small machines.
# Inside a container /proc/meminfo may show the whole host, so also honour a
# cgroup memory limit when one is visible (cgroup v2 memory.max or v1 limit).
if [[ -z "$NUMJOBS" ]] && [ -r /proc/meminfo ]; then
  MEM_KB=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  for f in /sys/fs/cgroup/memory.max /sys/fs/cgroup/memory/memory.limit_in_bytes; do
    if [ -r "$f" ]; then
      LIMIT=$(cat "$f" 2>/dev/null)
      if [[ "$LIMIT" =~ ^[0-9]+$ ]] && [ $((LIMIT / 1024)) -lt "${MEM_KB:-0}" ]; then
        MEM_KB=$((LIMIT / 1024))
      fi
    fi
  done
  MEM_GB=$(((${MEM_KB:-0} + 524288) / 1048576))
  if [ "${MEM_GB:-0}" -ge 1 ] && [ "$MJOBS" -gt "$MEM_GB" ]; then
    MJOBS=$MEM_GB
  fi
fi

# Common CMake arguments: static libs only, and never pick up packages from
# Homebrew/MacPorts, which would make the binaries depend on dylibs.
CMAKE_COMMON=(
  -DCMAKE_INSTALL_PREFIX="${WORKSPACE}"
  -DCMAKE_INSTALL_LIBDIR=lib
  -DCMAKE_INSTALL_BINDIR=bin
  -DCMAKE_INSTALL_INCLUDEDIR=include
  -DCMAKE_PREFIX_PATH="${WORKSPACE}"
  -DCMAKE_IGNORE_PREFIX_PATH="/opt/homebrew;/usr/local;/opt/local"
  -DCMAKE_BUILD_TYPE=Release
  -DBUILD_SHARED_LIBS=OFF
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON
  -DCMAKE_POLICY_VERSION_MINIMUM=3.5 # CMake 4 refuses projects declaring < 3.5
  -G Ninja
)

MESON_COMMON=(
  --prefix="${WORKSPACE}"
  --libdir=lib
  --buildtype=release
  --default-library=static
  --wrap-mode=nofallback
)

# fetch <url> <output file>: download with curl, or wget if curl is missing
fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fL --silent --show-error --retry 3 --retry-delay 10 -o "$2" "$1"
  else
    wget -q --tries=3 --waitretry=10 -O "$2" "$1"
  fi
}

# version_ge <a> <b>: true if version a >= b
version_ge() {
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$2" ]
}

make_dir() {
  remove_dir "$1"
  if ! mkdir -p "$1"; then
    printf "\n Failed to create dir %s" "$1"
    exit 1
  fi
}

remove_dir() {
  if [ -d "$1" ]; then
    rm -rf "$1"
  fi
}

download() {
  # download url [filename [dirname]]
  # If dirname is given, the archive is extracted into it without stripping
  # the top-level directory.

  DOWNLOAD_PATH="$PACKAGES"
  DOWNLOAD_FILE="${2:-"${1##*/}"}"

  if [[ "$DOWNLOAD_FILE" =~ tar. ]]; then
    TARGETDIR="${DOWNLOAD_FILE%.*}"
    TARGETDIR="${3:-"${TARGETDIR%.*}"}"
  else
    TARGETDIR="${3:-"${DOWNLOAD_FILE%.*}"}"
  fi

  if [ ! -f "$DOWNLOAD_PATH/$DOWNLOAD_FILE" ]; then
    echo "Downloading $1 as $DOWNLOAD_FILE"
    if ! fetch "$1" "$DOWNLOAD_PATH/$DOWNLOAD_FILE.part"; then
      echo ""
      echo "Failed to download $1"
      rm -f "$DOWNLOAD_PATH/$DOWNLOAD_FILE.part"
      exit 1
    fi
    mv "$DOWNLOAD_PATH/$DOWNLOAD_FILE.part" "$DOWNLOAD_PATH/$DOWNLOAD_FILE"
    echo "... Done"
  else
    echo "$DOWNLOAD_FILE has already downloaded."
  fi

  make_dir "$DOWNLOAD_PATH/$TARGETDIR"

  if [ -n "$3" ]; then
    STRIP=()
  else
    STRIP=(--strip-components 1)
  fi
  if ! tar -xf "$DOWNLOAD_PATH/$DOWNLOAD_FILE" -C "$DOWNLOAD_PATH/$TARGETDIR" "${STRIP[@]}" >/dev/null 2>&1; then
    echo "Failed to extract $DOWNLOAD_FILE"
    exit 1
  fi

  echo "Extracted $DOWNLOAD_FILE"

  cd "$DOWNLOAD_PATH/$TARGETDIR" || {
    echo "Error has occurred."
    exit 1
  }
}

execute() {
  echo "$ $*"

  OUTPUT=$("$@" 2>&1)

  # shellcheck disable=SC2181
  if [ $? -ne 0 ]; then
    echo "$OUTPUT"
    echo ""
    echo "Failed to Execute $*" >&2
    exit 1
  fi
}

# Portable in-place sed (GNU and BSD)
sed_i() {
  sed -i.sedbak "$@" && find . -maxdepth 4 -name '*.sedbak' -delete
}

meson_build() {
  execute meson setup build "${MESON_COMMON[@]}" "$@"
  execute meson compile -C build -j "$MJOBS"
  execute meson install -C build
}

cmake_build() {
  # cmake_build <source dir> [extra cmake args...]
  local src="$1"
  shift
  execute cmake -S "$src" -B cmake-build "${CMAKE_COMMON[@]}" "$@"
  execute cmake --build cmake-build -j "$MJOBS"
  execute cmake --install cmake-build
}

# Many older C libraries don't compile as C23 (the default since GCC 15) and
# trip errors that GCC 14+ / recent Clang no longer treat as warnings.
LEGACY_CC="${CC:-cc} -std=gnu17 -Wno-error=incompatible-pointer-types -Wno-error=int-conversion"
LEGACY_CC+=" -Wno-error=implicit-function-declaration -Wno-error=implicit-int"

autotools_build() {
  execute ./configure --prefix="${WORKSPACE}" --enable-static --disable-shared CC="${LEGACY_CC}" "$@"
  execute make -j "$MJOBS"
  execute make install
}

build() {
  echo ""
  echo "building $1"
  echo "======================="

  if [ -f "$PACKAGES/$1.done" ]; then
    echo "$1 already built. Remove $PACKAGES/$1.done lockfile to rebuild it."
    return 1
  fi

  return 0
}

command_exists() {
  if ! [[ -x $(command -v "$1") ]]; then
    return 1
  fi

  return 0
}

library_exists() {
  pkg-config --exists "$1" >/dev/null 2>&1
}

build_done() {
  touch "$PACKAGES/$1.done"
}

verify_binary_type() {
  echo ""
  if command_exists "file"; then
    echo "Built binary for ${OSTYPE}: $(file -b "$WORKSPACE/bin/ffmpeg")"
  fi
  echo "Linked libraries:"
  if $IS_MACOS; then
    otool -L "$WORKSPACE/bin/ffmpeg"
    # Anything outside the OS (eg. Homebrew) would make the binary non-portable
    if otool -L "$WORKSPACE/bin/ffmpeg" | tail -n +2 | grep -vqE '^\s+(/usr/lib/|/System/Library/)'; then
      echo "WARNING: ffmpeg links against libraries that are not part of macOS."
    fi
  else
    ldd "$WORKSPACE/bin/ffmpeg" 2>&1 || true
  fi
}

cleanup() {
  remove_dir "$PACKAGES"
  remove_dir "$WORKSPACE"
  echo "Cleanup done."
  echo ""
}

usage() {
  echo "Usage: $PROGNAME [OPTIONS]"
  echo "Options:"
  echo "  -h, --help                     Display usage information"
  echo "      --version                  Display version information"
  echo "  -b, --build                    Starts the build process"
  echo "      --enable-gpl-and-non-free  Enable GPL and non-free codecs  - https://ffmpeg.org/legal.html"
  echo "  -c, --cleanup                  Remove all working dirs"
  echo "      --full-static              Build a full static FFmpeg binary (eg. libc, pthreads etc...) **only Linux**"
  echo "                                 Note: Use a musl based distribution (eg. Alpine) for this. glibc does not"
  echo "                                 support static linking well because of NSS (Name Service Switch)."
  echo ""
}

while (($# > 0)); do
  case $1 in
  -h | --help)
    usage
    exit 0
    ;;
  --version)
    echo "$VERSION"
    exit 0
    ;;
  -b | --build)
    bflag='-b'
    ;;
  --enable-gpl-and-non-free)
    CONFIGURE_OPTIONS+=("--enable-nonfree")
    CONFIGURE_OPTIONS+=("--enable-gpl")
    NONFREE_AND_GPL=true
    ;;
  -c | --cleanup)
    cflag='-c'
    cleanup
    ;;
  --full-static)
    if $IS_MACOS; then
      echo "Error: A full static binary can only be build on Linux."
      exit 1
    fi
    LDEXEFLAGS="-static"
    ;;
  *)
    usage
    exit 1
    ;;
  esac
  shift
done

echo "ffmpeg-build-script v$VERSION (FFmpeg $FFMPEG_VERSION)"
echo "========================="
echo ""

if [ -z "$bflag" ]; then
  if [ -z "$cflag" ]; then
    usage
    exit 1
  fi
  exit 0
fi

echo "Using $MJOBS make jobs simultaneously."

if [ -n "$LDEXEFLAGS" ]; then
  echo "Start the build in full static mode."
fi

mkdir -p "$PACKAGES"
mkdir -p "$WORKSPACE/lib/pkgconfig"

export PATH="${WORKSPACE}/bin:$PATH"
# Only our own packages are visible to pkg-config. On Linux (non full-static)
# the system paths are added so libva can be found for vaapi.
PKG_CONFIG_PATH="${WORKSPACE}/lib/pkgconfig:${WORKSPACE}/share/pkgconfig"
if $IS_LINUX && [ -z "$LDEXEFLAGS" ]; then
  MULTIARCH="$(gcc -dumpmachine 2>/dev/null)"
  PKG_CONFIG_PATH+=":/usr/local/lib/pkgconfig:/usr/lib/${MULTIARCH}/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig:/usr/lib64/pkgconfig"
fi
export PKG_CONFIG_PATH
export PKG_CONFIG="${WORKSPACE}/bin/pkg-config"
# Prevent pkgconf from falling back to its compiled-in system search path
export PKG_CONFIG_LIBDIR="${PKG_CONFIG_PATH}"

for tool in make cc c++ ninja perl python3; do
  if ! command_exists "$tool"; then
    echo "$tool not installed."
    if $IS_MACOS; then
      echo "Install the Xcode command line tools and run: brew install cmake meson ninja"
    fi
    exit 1
  fi
done
if ! command_exists curl && ! command_exists wget; then
  echo "curl or wget is required."
  exit 1
fi

##
## CMake and Meson: use the installed ones if recent enough, otherwise
## download them into packages/ (no root needed)
##

CMAKE_DIR="$PACKAGES/cmake-${CMAKE_VERSION}"
if [ -x "$CMAKE_DIR/bin/cmake" ]; then
  export PATH="$CMAKE_DIR/bin:$PATH"
elif ! command_exists cmake || ! version_ge "$(cmake --version | head -1 | awk '{print $3}')" "$CMAKE_MIN_VERSION"; then
  echo "cmake >= $CMAKE_MIN_VERSION not found, downloading CMake $CMAKE_VERSION"
  if $IS_MACOS; then
    CMAKE_PKG="macos-universal"
  else
    CMAKE_PKG="linux-${ARCH}"
  fi
  (
    download "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-${CMAKE_PKG}.tar.gz" "cmake-${CMAKE_VERSION}-bin.tar.gz" "cmake-${CMAKE_VERSION}-unpack"
  ) || exit 1
  make_dir "$CMAKE_DIR"
  if $IS_MACOS; then
    mv "$PACKAGES/cmake-${CMAKE_VERSION}-unpack"/*/CMake.app/Contents/* "$CMAKE_DIR/"
  else
    mv "$PACKAGES/cmake-${CMAKE_VERSION}-unpack"/*/* "$CMAKE_DIR/"
  fi
  remove_dir "$PACKAGES/cmake-${CMAKE_VERSION}-unpack"
  export PATH="$CMAKE_DIR/bin:$PATH"
fi

MESON_PY="$PACKAGES/meson-${MESON_VERSION}/meson.py"
if [ ! -f "$MESON_PY" ] && { ! command_exists meson || ! version_ge "$(meson --version)" "$MESON_MIN_VERSION"; }; then
  echo "meson >= $MESON_MIN_VERSION not found, downloading Meson $MESON_VERSION"
  (download "https://github.com/mesonbuild/meson/releases/download/${MESON_VERSION}/meson-${MESON_VERSION}.tar.gz") || exit 1
fi
if [ -f "$MESON_PY" ]; then
  mkdir -p "$WORKSPACE/bin"
  printf '#!/bin/sh\nexec python3 "%s" "$@"\n' "$MESON_PY" >"$WORKSPACE/bin/meson"
  chmod +x "$WORKSPACE/bin/meson"
fi

echo "Using $(cmake --version | head -1), meson $(meson --version), ninja $(ninja --version)"

##
## build tools
##

if build "pkg-config"; then
  download "https://distfiles.ariadne.space/pkgconf/pkgconf-${PKGCONF_VERSION}.tar.xz"
  execute ./configure --prefix="${WORKSPACE}" --disable-shared --enable-static \
    --with-pkg-config-dir="${WORKSPACE}/lib/pkgconfig:${WORKSPACE}/share/pkgconfig" \
    --with-system-libdir=/usr/lib --with-system-includedir=/usr/include
  execute make -j "$MJOBS"
  execute make install
  ln -sf pkgconf "${WORKSPACE}/bin/pkg-config"
  build_done "pkg-config"
fi

if build "nasm"; then
  download "https://www.nasm.us/pub/nasm/releasebuilds/${NASM_VERSION}/nasm-${NASM_VERSION}.tar.xz"
  execute ./configure --prefix="${WORKSPACE}" CC="${LEGACY_CC}"
  execute make -j "$MJOBS"
  execute make install
  build_done "nasm"
fi

if build "zlib"; then
  download "https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz"
  execute ./configure --static --prefix="${WORKSPACE}"
  execute make -j "$MJOBS"
  execute make install
  build_done "zlib"
fi

if build "bzip2"; then
  download "https://sourceware.org/pub/bzip2/bzip2-${BZIP2_VERSION}.tar.gz"
  execute make -j "$MJOBS" libbz2.a CC="${LEGACY_CC}" CFLAGS="-O2 -fPIC -D_FILE_OFFSET_BITS=64"
  execute install -m 644 bzlib.h "${WORKSPACE}/include/"
  execute install -m 644 libbz2.a "${WORKSPACE}/lib/"
  cat <<_EOF_ >"${WORKSPACE}/lib/pkgconfig/bzip2.pc"
prefix=${WORKSPACE}
exec_prefix=\${prefix}
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: bzip2
Description: Lossless, block-sorting data compression
URL: https://sourceware.org/bzip2
Version: ${BZIP2_VERSION}
Libs: -L\${libdir} -lbz2
Cflags: -I\${includedir}
_EOF_
  build_done "bzip2"
fi

if build "libpng"; then
  download "https://downloads.sourceforge.net/project/libpng/libpng16/${LIBPNG_VERSION}/libpng-${LIBPNG_VERSION}.tar.xz"
  autotools_build --disable-dependency-tracking CPPFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}"
  build_done "libpng"
fi

if build "expat"; then
  download "https://github.com/libexpat/libexpat/releases/download/R_${EXPAT_VERSION//./_}/expat-${EXPAT_VERSION}.tar.xz"
  autotools_build --without-docbook --without-examples --without-tests
  build_done "expat"
fi

if $NONFREE_AND_GPL; then
  if build "openssl"; then
    download "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz"
    # openssldir=/etc/ssl so the static binary finds the system CA bundle on other machines
    execute ./Configure --prefix="${WORKSPACE}" --openssldir=/etc/ssl --libdir=lib \
      no-shared no-tests no-docs zlib --with-zlib-include="${WORKSPACE}/include" --with-zlib-lib="${WORKSPACE}/lib"
    execute make -j "$MJOBS"
    execute make install_sw
    build_done "openssl"
  fi
  CONFIGURE_OPTIONS+=("--enable-openssl")
fi

##
## video library
##

if build "svtav1"; then
  download "https://gitlab.com/AOMediaCodec/SVT-AV1/-/archive/v${SVTAV1_VERSION}/SVT-AV1-v${SVTAV1_VERSION}.tar.gz"
  cmake_build . -DBUILD_APPS=OFF -DBUILD_TESTING=OFF -DENABLE_NASM=ON
  build_done "svtav1"
fi
CONFIGURE_OPTIONS+=("--enable-libsvtav1")

if $NONFREE_AND_GPL; then
  if build "x264"; then
    download "https://code.videolan.org/videolan/x264/-/archive/${X264_COMMIT}/x264-${X264_COMMIT}.tar.bz2" "x264.tar.bz2"
    execute ./configure --prefix="${WORKSPACE}" --enable-static --enable-pic --disable-cli
    execute make -j "$MJOBS"
    execute make install
    build_done "x264"
  fi
  CONFIGURE_OPTIONS+=("--enable-libx264")
fi

if $NONFREE_AND_GPL; then
  if build "x265"; then
    download "https://download.videolan.org/pub/videolan/x265/x265_${X265_VERSION}.tar.gz" "x265-${X265_VERSION}.tar.gz"
    # CMake 4 no longer allows setting these policies to OLD
    # and with CMP0025 NEW Apple's compiler is "AppleClang", which x265 must treat as Clang.
    sed_i -e '/cmake_policy(SET CMP0025 OLD)/d' -e '/cmake_policy(SET CMP0054 OLD)/d' \
      -e 's/(${CMAKE_CXX_COMPILER_ID} STREQUAL "Clang")/(CMAKE_CXX_COMPILER_ID MATCHES "Clang")/' source/CMakeLists.txt
    cmake_build source -DENABLE_SHARED=OFF -DENABLE_CLI=OFF
    # x265.pc doesn't list the C++ runtime needed for static linking
    sed_i "s|^Libs.private:.*|& ${CXXLIB}|" "${WORKSPACE}/lib/pkgconfig/x265.pc"
    if [ -n "$LDEXEFLAGS" ]; then
      sed_i 's/-lgcc_s/-lgcc_eh/g' "${WORKSPACE}/lib/pkgconfig/x265.pc"
    fi
    build_done "x265"
  fi
  CONFIGURE_OPTIONS+=("--enable-libx265")
fi

if build "libvpx"; then
  download "https://github.com/webmproject/libvpx/archive/v${LIBVPX_VERSION}.tar.gz" "libvpx-${LIBVPX_VERSION}.tar.gz"
  execute ./configure --prefix="${WORKSPACE}" --disable-unit-tests --disable-shared --enable-static \
    --disable-examples --disable-tools --disable-docs --enable-pic --enable-vp9-highbitdepth
  execute make -j "$MJOBS"
  execute make install
  build_done "libvpx"
fi
CONFIGURE_OPTIONS+=("--enable-libvpx")

if $NONFREE_AND_GPL; then
  if build "xvidcore"; then
    download "https://downloads.xvid.com/downloads/xvidcore-${XVIDCORE_VERSION}.tar.gz"
    cd build/generic || exit
    execute ./configure --prefix="${WORKSPACE}" --disable-shared --enable-static CC="${LEGACY_CC}"
    execute make -j "$MJOBS"
    execute make install
    # xvidcore always installs a shared library as well
    rm -f "${WORKSPACE}"/lib/libxvidcore.*dylib "${WORKSPACE}"/lib/libxvidcore.so*
    build_done "xvidcore"
  fi
  CONFIGURE_OPTIONS+=("--enable-libxvid")
fi

if $NONFREE_AND_GPL; then
  if build "vid_stab"; then
    download "https://github.com/georgmartius/vid.stab/archive/v${VIDSTAB_VERSION}.tar.gz" "vid.stab-${VIDSTAB_VERSION}.tar.gz"
    cmake_build . -DUSE_OMP=OFF
    build_done "vid_stab"
  fi
  CONFIGURE_OPTIONS+=("--enable-libvidstab")
fi

if build "av1"; then
  download "https://storage.googleapis.com/aom-releases/libaom-${LIBAOM_VERSION}.tar.gz"
  cmake_build . -DENABLE_TESTS=0 -DENABLE_TESTDATA=0 -DENABLE_DOCS=0 -DENABLE_EXAMPLES=0 -DENABLE_TOOLS=0 -DENABLE_APPS=0
  build_done "av1"
fi
CONFIGURE_OPTIONS+=("--enable-libaom")

if build "dav1d"; then
  download "https://code.videolan.org/videolan/dav1d/-/archive/${DAV1D_VERSION}/dav1d-${DAV1D_VERSION}.tar.bz2"
  meson_build -Denable_tools=false -Denable_tests=false
  build_done "dav1d"
fi
CONFIGURE_OPTIONS+=("--enable-libdav1d")

##
## audio library
##

if build "opencore"; then
  download "https://downloads.sourceforge.net/project/opencore-amr/opencore-amr/opencore-amr-${OPENCORE_AMR_VERSION}.tar.gz"
  autotools_build
  build_done "opencore"
fi
CONFIGURE_OPTIONS+=("--enable-libopencore_amrnb" "--enable-libopencore_amrwb")

if build "lame"; then
  download "https://downloads.sourceforge.net/project/lame/lame/${LAME_VERSION}/lame-${LAME_VERSION}.tar.gz"
  autotools_build --disable-frontend --disable-decoder
  build_done "lame"
fi
CONFIGURE_OPTIONS+=("--enable-libmp3lame")

if build "opus"; then
  download "https://ftp.osuosl.org/pub/xiph/releases/opus/opus-${OPUS_VERSION}.tar.gz"
  autotools_build --disable-doc --disable-extra-programs
  build_done "opus"
fi
CONFIGURE_OPTIONS+=("--enable-libopus")

if build "libogg"; then
  download "https://ftp.osuosl.org/pub/xiph/releases/ogg/libogg-${LIBOGG_VERSION}.tar.xz"
  autotools_build
  build_done "libogg"
fi

if build "libvorbis"; then
  download "https://ftp.osuosl.org/pub/xiph/releases/vorbis/libvorbis-${LIBVORBIS_VERSION}.tar.xz"
  # The modern Apple linker rejects this obsolete flag
  sed_i 's/ -force_cpusubtype_ALL//g' configure
  autotools_build --with-ogg-libraries="${WORKSPACE}/lib" --with-ogg-includes="${WORKSPACE}/include/" --disable-oggtest
  build_done "libvorbis"
fi
CONFIGURE_OPTIONS+=("--enable-libvorbis")

if build "libtheora"; then
